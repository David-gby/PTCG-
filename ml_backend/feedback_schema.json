{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ptcg/feedback.schema.json",
  "title": "PTCG human-reviewed model feedback",
  "type": "object",
  "required": [
    "schema_version",
    "sample_id",
    "created_at_utc",
    "image",
    "model",
    "review",
    "outer_frame",
    "rectification",
    "inner_frame"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sample_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "image": {
      "type": "object",
      "required": ["path", "sha256", "width", "height", "color_order"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "color_order": {"const": "BGR"}
      }
    },
    "model": {
      "type": "object",
      "required": ["pipeline_version", "package_version", "models"]
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "approved_for_training",
        "training_eligible",
        "issue_tags"
      ],
      "properties": {
        "status": {
          "enum": ["corrected", "accepted_prediction", "rejected", "no_inner_frame"]
        },
        "approved_for_training": {"type": "boolean"},
        "training_eligible": {"type": "boolean"},
        "issue_tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "outer_frame": {
      "type": "object",
      "required": [
        "coordinate_space",
        "corner_order",
        "prediction",
        "correction",
        "selected_for_rectification"
      ],
      "properties": {
        "coordinate_space": {"const": "original_image_pixels"},
        "corner_order": {"const": ["tl", "tr", "br", "bl"]},
        "correction": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["points"],
              "properties": {
                "points": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number"}
                  }
                }
              }
            }
          ]
        }
      }
    },
    "rectification": {
      "type": "object",
      "required": ["image_path", "output_size", "homography", "based_on"],
      "properties": {
        "output_size": {"const": [630, 880]},
        "based_on": {"enum": ["manual_correction", "model_prediction"]}
      }
    },
    "inner_frame": {
      "type": "object",
      "required": [
        "coordinate_space",
        "coordinates_reference",
        "edge_visibility",
        "prediction",
        "correction"
      ],
      "properties": {
        "coordinate_space": {"const": "rectified_card_pixels"},
        "coordinates_reference": {
          "enum": [
            "rectified_from_manual_outer_correction",
            "rectified_from_model_outer_prediction"
          ]
        },
        "correction": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["box", "corners_tl_tr_br_bl"]
            }
          ]
        }
      }
    }
  }
}
